	(text "C1-C6: IOVDD pins 1/10/22/33/42/49. C7/C8: DVDD pins 23/50.\nC9 USB_VDD; C10 ADC_AVDD. C27 VREG_IN; C28 VREG_OUT.\nPlace each capacitor at its corresponding supply pin."
		(exclude_from_sim no)
		(at 25.4 238.76 0)
		(effects
