		(uuid "76182d85-fef8-5ab7-a0a5-dd2eb05f6139")
	)
	(text "IOVDD: pins 1/10/22/33/42/49 share the shown pin.\nAll six connect to +3V3; C2 decouples pin 10."
		(exclude_from_sim no)
		(at 25.4 40.64 0)
		(effects
